   "properties": {
    "id": "structure:short-line-tunnel-4:trestle",
    "name": "Curved timber trestle at the south portal",
    "valid_from": 1901,
    "grade": "inferred",
    "error_ft": 100,
    "basis": "Its line is the middle of the track in McClure's photograph (MCC-83), carried down each sight line from the solved camera to rail level. The camera is good only to about 150 ft, and the line shows it: the far end comes down about 45 ft short of the grade it must have joined and 17 ft in the air. So the course is good to perhaps 100 ft, and the length (about 500 ft) and height (up to about 70 ft) to perhaps a quarter. It crosses a deep hollow that today's road goes round; OpenStreetMap carries an abandoned-railway line across the same hollow on a somewhat more westerly course.",
    "sources": [
     "source:lidar-3dep",
     "source:dpl-mcc-83"
    ],
