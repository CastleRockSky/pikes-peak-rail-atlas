   "properties": {
    "id": "structure:murphy:road-junction-1954",
    "name": "Road from the west meeting the grade at the bend (1954 map)",
    "valid_from": 1954,
    "valid_to": 1954,
    "grade": "measured",
    "error_ft": 100,
    "basis": "The 1954 Divide sheet draws a dashed road coming from the west past 'Springs' and spot height 9665 and meeting the old railroad grade at its bend below Tracy Hill. On the 1 m lidar a faint track joins the bend fill from the south-west (by eye). The road is after the railway's time on the map; whether a road met the railway here when it ran is not known.",
    "sources": [
     "source:usgs-divide-1954",
     "source:lidar-3dep"
    ],
