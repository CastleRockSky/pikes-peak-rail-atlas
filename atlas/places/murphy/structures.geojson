   "properties": {
    "id": "structure:murphy:grade-sidehill-to-summit",
    "name": "Midland Terminal grade: side-hill bench climbing to the summit, past the mileage point",
    "valid_from": 1894,
    "valid_to": 1949,
    "grade": "measured",
    "error_ft": 15,
    "basis": "On the 1 m lidar a narrow bench is cut into the west side of the valley and built out on the east as a fill 2 to 3 m high, for about 1810 ft (cross-sections every 0.0125 mile). Its flat top reads 3 to 6 m wide, enough for one track; no widening that would hold a second track (a passing siding) was found along it. It climbs at 1.9 to 2.4 per cent, very smoothly (roughness about the best straight slope under 0.15 m over 200 m). The 1954 sheet's 'OLD RAILROAD GRADE' follows it to the bend. The timetable mileage point (30.4 miles from Colorado Springs) lies on it.",
    "sources": [
     "source:lidar-3dep",
     "source:usgs-divide-1954"
    ],
    "status": "reviewed",
    "contributor": "project",
    "updated": "2026-11-24",
    "place": "place:murphy",
    "kind": "earthwork",
    "placeholder": false
   }
