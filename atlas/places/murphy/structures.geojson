   "properties": {
    "id": "structure:murphy:bend-fill",
    "name": "Fill across the head of a west-draining gulch, at the sharp bend",
    "valid_from": 1894,
    "valid_to": 1949,
    "grade": "measured",
    "error_ft": 15,
    "basis": "On the 1 m lidar the grade turns from south-west to south-east on a fill about 630 ft long that stands about 4.5 m above the head of the gulch to its west, with a top 8 to 13 m wide (east-west sections at 10 m steps; the widest reading is where the section cuts the curve obliquely). The 1954 sheet draws the grade making this bend at the foot of Tracy Hill and a road coming in from the west to meet it here.",
    "sources": [
     "source:lidar-3dep",
     "source:usgs-divide-1954"
    ],
