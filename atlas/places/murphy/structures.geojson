   "properties": {
    "id": "structure:murphy:summit-cut",
    "name": "Cut through the summit between the Divide and Midland sides",
    "valid_from": 1894,
    "valid_to": 1949,
    "grade": "measured",
    "error_ft": 15,
    "basis": "On the 1 m lidar the grade runs for about 630 ft in a cut 2 to 3.6 m deep and about 15 m across at the top, beyond the bend. South of it the grade falls at 2.2 to 2.8 per cent towards Midland, then more steeply (5 per cent over 0.15 mile about 0.8 mile further on, already listed among the route's weak stretches).",
    "sources": [
