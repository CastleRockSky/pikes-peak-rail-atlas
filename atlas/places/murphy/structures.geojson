   "properties": {
    "id": "structure:murphy:grade-west-of-creek",
    "name": "Midland Terminal grade on the hillside west of the creek and the pond",
    "valid_from": 1894,
    "valid_to": 1949,
    "grade": "measured",
    "error_ft": 20,
    "basis": "On the 1 m lidar a narrow bench runs for about 5580 ft along the hillside west of the creek and of a small pond, from where it leaves the side of the present highway (2.2 timetable miles from Divide) to where it becomes the side-hill bench below (3.3). Its line was traced by eye on the hillshade, slid onto the bench within 8 m by route_check.snap, and joined to the highway end by route_check.find_path with a 2.5 per cent ruling grade; route_check reads all of it on a smooth grade, climbing at 0.7 to 3.3 per cent (2.0 on average). The 1954 USGS Divide sheet prints 'OLD RAILROAD GRADE' along it, west of the creek, and marks 'Well 9308' near its south end; parts are now the Elk Meadow and Cheesman Ranch trails of Mueller State Park (OpenStreetMap). The route here is the corrected line of once_route_mt_murphy.py (24 Nov 2026). The first line, found from the lidar by once_route_mt.py, ran on the creek's flat floor 30 to 65 m to the east from about 2.25 to 3.31 route miles, with a small kink; this place's first records (earlier the same day) described that floor and a bank under the highway as the grade, which was wrong. Dates are the railway's: line opened 1893 to 1894 (secondary), last timetable read March 1948, closed 1949 (secondary).",
    "sources": [
     "source:lidar-3dep",
     "source:usgs-divide-1954",
     "source:usgs-divide-1994"
    ],
    "status": "reviewed",
    "contributor": "project",
    "updated": "2026-11-24",
    "place": "place:murphy",
    "kind": "earthwork",
    "placeholder": false
   }
