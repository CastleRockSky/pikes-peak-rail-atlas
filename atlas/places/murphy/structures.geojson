   "properties": {
    "id": "structure:murphy:buildings-1954",
    "name": "Three buildings east of the stream (1954 map)",
    "valid_from": 1954,
    "valid_to": 1994,
    "grade": "measured",
    "error_ft": 40,
    "basis": "The 1954 Divide sheet marks three building symbols (one open, two solid) on the slope between the stream and the highway, about 700 ft east of the grade and level with 3.15 timetable miles. The 1994 sheet marks two or three there. Their date and use are not known; they are entered only because they are the buildings nearest the stop on any map held.",
    "sources": [
