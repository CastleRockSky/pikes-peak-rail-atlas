   "properties": {
    "id": "structure:murphy:summit",
    "name": "Summit of the line between Divide and Midland (lidar ground 9,392 ft)",
    "valid_from": 1894,
    "valid_to": 1949,
    "grade": "measured",
    "error_ft": 50,
    "basis": "The highest ground along the route between Divide and Midland: about 2,862.7 m (9,392 ft) on the 1 m lidar, at 3.70 route miles from the Divide junction (3.67 timetable miles), between the bend fill and the summit cut. The grade climbs to it from Divide at about 2 per cent and falls from it towards Midland. Its height is the present ground on the old formation, not rail level. 0.17 timetable mile (about 900 ft) beyond the point where the printed mileage puts Murphy. That a stop at the summit of the line is where trains would stand (to set or release brakes) is a conjecture, not a record.",
    "sources": [
     "source:lidar-3dep"
    ],
    "status": "reviewed",
    "contributor": "project",
    "updated": "2026-11-24",
    "place": "place:murphy",
