   "properties": {
    "id": "feature:skaguay-incline",
    "name": "Incline above the Skaguay power plant (lower part)",
    "kind": "incline",
    "grade": "measured",
    "error_ft": 20,
    "length_ft": 1826,
    "basis": "A dead-straight cut up the slope from the plant's pad, plain on the 1 m lidar for 1,800 ft and drawn on the 1951 USGS map as a double-dashed line. The accounts say the plant was reached by a cable car. Whether the pressure pipe to the plant ran down the same cut is not established. Above this point the line passes a cliff and goes on to the plateau as a track.",
