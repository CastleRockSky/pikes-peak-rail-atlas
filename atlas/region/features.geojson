   "properties": {
    "id": "feature:skaguay-pipeline-a",
    "name": "Skaguay pipeline, from the pipe seen near the dam to the first side valley",
    "kind": "pipeline",
    "grade": "inferred",
    "error_ft": 30,
    "length_ft": 3234,
    "basis": "A thin raised line shows on the 1 m lidar from the place where the owner photographed the wood-stave pipe, running south along the west side of the valley. Over its last 1,500 ft the ground on it reads 8,849 to 8,856 ft at twelve points: level to within a few feet while the creek beside it falls away. A path or a road would not hold a level so closely; a water line would. Taken to be the pipe's bed on that ground: inferred, not seen on any map.",
    "sources": [
     "source:lidar-3dep",
     "source:owner-field-photographs",
     "source:skaguay-secondary"
    ],
    "valid_from": 1901,
