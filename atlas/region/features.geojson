   "properties": {
    "id": "feature:skaguay-pipeline-head",
    "name": "Skaguay power plant: pressure pipe above the incline's cut (conjecture)",
    "kind": "incline",
    "grade": "conjecture",
    "error_ft": 150,
    "length_ft": 405,
    "basis": "The straight incline above the plant, produced up the slope on its own bearing, reaches the pipe's level (about 8,780 ft) here, on a short near-level stretch; above this the ground rises steeply past 8,870 ft. Taken to be about where the wood-stave line ended and the steel pressure pipe began, the pressure pipe then running straight down the incline to the plant, about 2,440 ft on the slope. No trace of a pipe was seen on the ground between here and the top of the cut.",
    "sources": [
     "source:lidar-3dep",
     "source:owner-field-photographs",
     "source:skaguay-secondary"
    ],
    "valid_from": 1901,
