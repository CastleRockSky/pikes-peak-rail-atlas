   "properties": {
    "id": "feature:skaguay-pipeline-d2",
    "name": "Skaguay pipeline, continued as a level line (computed, not seen)",
    "kind": "pipeline",
    "grade": "conjecture",
    "error_ft": 150,
    "length_ft": 3070,
    "basis": "Beyond the last point where the line can be seen, this is the 8,792 ft level followed along the hillside by calculation, with one gully of 400 ft jumped. A cut shelf was detected along most of it, but two passes failed to pick out the pipe's bed here. A straight line does cross that gully, dipping about 150 ft: a sag in the pipe or a road, and it cannot be told which. Conjecture.",
