   "properties": {
    "id": "feature:skaguay-pipeline-e",
    "name": "Skaguay pipeline, the last stretch to the head of the pressure pipe (not found; a level line only)",
    "kind": "pipeline",
    "grade": "conjecture",
    "error_ft": 400,
    "length_ft": 4026,
    "basis": "Nothing of the pipe was found on this ground in two searches. The line drawn is only the 8,800 ft level carried round the spur and along the cliffs to where the straight incline above the plant, produced upward, reaches that level: it shows where a pipe kept at grade would have to go, not where this one went. The accounts give the line a tunnel of 1,535 ft. The only ridge here that a level bore of that length would cut is this spur, from about 38.6456, -105.0538 to 38.6412, -105.0530 (1,605 ft); no portal, cut or spoil was seen at either end, so the tunnel is not drawn. The lengths do not settle it: with or without the tunnel the whole comes within about 1,200 ft of the 23,200 ft given.",
    "sources": [
     "source:lidar-3dep",
     "source:owner-field-photographs",
     "source:skaguay-secondary"
    ],
    "valid_from": 1901,
    "valid_to": 1965,
    "status": "draft",
    "contributor": "project",
    "updated": "2026-11-25"
   }
