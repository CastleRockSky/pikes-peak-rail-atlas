   "properties": {
    "id": "feature:skaguay-pipeline-c",
    "name": "Skaguay pipeline, the level run above Beaver Creek",
    "kind": "pipeline",
    "grade": "inferred",
    "error_ft": 30,
    "length_ft": 5166,
    "basis": "The line holds 8,789 to 8,803 ft at nearly every point read over about a mile, while the creek drops well below it and the line leaves the creek for the hillside to the south-west. It dips once into a small gully for about 300 ft (taken to have been bridged) and is level again beyond. Taken to be the pipe's bed on the strength of that level: inferred.",
